{"findings":[{"id":"a3c7163b-9132-4c3f-a2d2-57ed76e5446f","title":"Wrong row number is called expected","description":"`nextSteps` appends a fixed sentence saying the failure is expected on a ticket PR's first commit because the number did not exist yet, for every ticket whose single row is not `done (PR <n>)`. When the row already carries a wrong number (for example `done (PR 37)` on PR 38), the number was known, so the reader is told something untrue and may skip a simple typo fix.","category":"Correctness","action_level":"informational","attribution_status":"pending","git_sha":"5e9d05a20998ed6bf4baa4123ba864b136a5cd59","location":{"file_path":"scripts/pr-ticket-check.ts","start_line":205,"end_line":206,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":"scripts/pr-ticket-check.ts[193-210]"},{"source_type":"pr_branch_file","source":"tickets/T-038-ticket-link-next-step.md[9-13]"}]}}],"finding_state":{"complete":true,"introduced":["a3c7163b-9132-4c3f-a2d2-57ed76e5446f"],"resolved":[],"still_open":[],"dismissed":[]},"review_agent_comment":"Nothing to comment.","meta":{"analysis":{"attempted_mode":"full","mode":"full","reason":"no_completed_checkpoint"},"checkpoint":{"base_sha":"5e9d05a20998ed6bf4baa4123ba864b136a5cd59","coverage_started_at":"2026-11-26T07:01:13.665095+00:00","created_at":"2026-11-26T07:01:13.665095+00:00","id":"27f9eee4fa1d4d679829cb4c3ecc0218","sequence":40979,"tree_sha":"a7fcb6ba00abedb10bcc0446be6f9e93efb730a0","version":1},"context":{"author_notes":{"input_chars":2410,"max_tokens":16000,"offloaded":false,"original_tokens":563,"outcome":"inline","rendered_chars":2580},"ticket_bodies":[]},"coverage":{"complete":true},"depth":"auto","org_config":"applied","reviewers":{"ran":["issue","compliance","skills"],"skipped":["spec","ui","persona","cross_repo"]},"run":{"effort":{"effective":"lite","requested":"auto"},"id":"2950a42fa0b14cfda6239d7cdd356c9b","passes":[{"agent_statuses_reported":true,"agents":[{"duration_ms":9488,"