{"findings":[{"id":"bb44ea06-f25e-428c-913b-592b4d4a31d8","title":"Factory script writes to process streams outside src/cli.ts","description":"`main` in `scripts/pr-ticket-check.ts` writes to `process.stdout` and `process.stderr` and sets `process.exitCode` directly, instead of returning values for `src/cli.ts` to display. The rule confines these process-level accesses to `src/cli.ts`, and the PR author's note argues that `scripts/` is exempt, but the checklist has no such carve-out. The entry block also sets `process.exitCode`, so any later reuse of `main` from another script or test inherits the stream writes and exit-code mutation.","category":"Maintainability","action_level":"action_required","attribution_status":"pending","git_sha":"6dc9a90e17e8b454f24bdb685db76b20c48b19b8","location":{"file_path":"scripts/pr-ticket-check.ts","start_line":146,"end_line":148,"side":"right"},"evidence":{"citations":[{"source_type":"rules","source":"https://app.qodo.ai/rules/4522070?state=active"},{"source_type":"pr_branch_file","source":"scripts/pr-ticket-check.ts[101-148]"}]}},{"id":"aad38bfd-122e-4235-8ffa-346caa6a27c5","title":"A ticket PR can close the wrong issue","description":"`checkPrTicket` accepts any closing keyword followed by an issue number without checking that the issue belongs to a ticket named in the title. A PR for T-008 can therefore pass with `Closes #1` and a matching backlog status even though the repository identifies T-008’s issue as #20; the same gap applies when a title names multiple tickets.","category":"Correctness","action_level":"action_required","attribution_status":"pending","git_sha":"6dc9a90e17e8b454f24bdb685db76b20c48b19b8","location":{"file_path":"scripts/pr-ticket-check.ts","start_line":82,"end_line":82,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":"scripts/pr-ticket-check.ts[35-36]"},{"source_type":"pr_branch_file","source":"scripts/pr-ticket-check.ts[78-97]"},{"source_type":"pr_branch_file","source":"BACKLOG.md[15-15]"},{"source_type":"pr_branch_file","source":".github/workflows/check.yml[65-70]"}]}},{"id":"0cc845e7-6751-40f8-86db-6e42f5342c37","title":"An added backlog row can hide stale status","description":"`backlogStatuses` silently overwrites an earlier ticket status when it encounters a second row with the same ID. If a PR appends a matching `done (PR <number>)` row without updating the original row, `ticket-link` passes despite the original backlog entry still having the wrong status.","category":"Correctness","action_level":"remediation_recommended","attribution_status":"pending","git_sha":"6dc9a90e17e8b454f24bdb685db76b20c48b19b8","location":{"file_path":"scripts/pr-ticket-check.ts","start_line":61,"end_line":61,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":"scripts/pr-ticket-check.ts[52-63]"},{"source_type":"pr_branch_file","source":"scripts/pr-ticket-check.ts[88-97]"},{"source_type":"pr_branch_file","source":"BACKLOG.md[7-15]"}]}},{"id":"8e3e55d2-d19b-4dea-8ff6-3685cab4f979","title":"A rejected ticket cannot retry as told","description":"The Investigation guard fails the labeled-event run but leaves `ready-for-agent` attached while telling the user to add that label again. Editing the issue and attempting to add an already-present label produces no new `labeled` event, so the corrected ticket does not start through the instructed retry path.","category":"Correctness","action_level":"remediation_recommended","attribution_status":"pending","git_sha":"6dc9a90e17e8b454f24bdb685db76b20c48b19b8","location":{"file_path":".github/workflows/agent-ticket.yml","start_line":58,"end_line":58,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":".github/workflows/agent-ticket.yml[23-25]"},{"source_type":"pr_branch_file","source":".github/workflows/agent-ticket.yml[40-41]"},{"source_type":"pr_branch_file","source":".github/workflows/agent-ticket.yml[48-60]"}]}},{"id":"7626e3f0-ecab-4b15-9aae-003e5df6c377","title":"A review install failure stops ticket work","description":"The Qodo setup step handles a failed `whoami` as unavailable, but its download, checksum, installer and version commands have no corresponding fallback. When any of those commands fails with a key configured, the step fails before the implementation agent runs, rather than allowing the pending-gate path used for an unavailable reviewer.","category":"Reliability","action_level":"remediation_recommended","attribution_status":"pending","git_sha":"6dc9a90e17e8b454f24bdb685db76b20c48b19b8","location":{"file_path":".github/workflows/agent-ticket.yml","start_line":90,"end_line":92,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":".github/workflows/agent-ticket.yml[73-76]"},{"source_type":"pr_branch_file","source":".github/workflows/agent-ticket.yml[83-107]"}]}}],"finding_state":{"complete":true,"introduced":["bb44ea06-f25e-428c-913b-592b4d4a31d8","aad38bfd-122e-4235-8ffa-346caa6a27c5","0cc845e7-6751-40f8-86db-6e42f5342c37","8e3e55d2-d19b-4dea-8ff6-3685cab4f979","7626e3f0-ecab-4b15-9aae-003e5df6c377"],"resolved":[],"still_open":[],"dismissed":[]},"review_agent_comment":"Nothing to comment.","meta":{"analysis":{"mode":"full","reason":"no_completed_checkpoint"},"checkpoint":{"base_sha":"6dc9a90e17e8b454f24bdb685db76b20c48b19b8","coverage_started_at":"2026-11-13T16:11:07.317837+00:00","created_at":"2026-11-13T16:11:07.317837+00:00","id":"540aac975e0c4006a7eb1a158a386e90","sequence":30512,"tree_sha":"5c8b57f18921b2f8a9fd9f34e8b97791096cb34f","version":1},"context":{"author_notes":{"input_chars":4250,"max_tokens":16000,"offloaded":false,"original_tokens":956,"outcome":"inline","rendered_chars":4420},"ticket_bodies":[]},"coverage":{"complete":true},"depth":"auto","org_config":"applied","reviewers":{"ran":["issue","compliance"],"skipped":["skills","spec","ui","persona","cross_repo"]},"run":{"effort":{"effective":"standard","requested":"auto"},"id":"dc2e1b0ab3e54200900ea5e7841463f