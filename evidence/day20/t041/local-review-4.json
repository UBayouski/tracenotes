{"findings":[{"id":"723eb8cd-9e0d-4bf6-9370-0fe9ee6e14b8","title":"First Pages deploy may fail on folder permissions","description":"`main` makes the staging directory with `mkdtempSync`, which on Linux always creates it owner-only (`0700`), and `renameSync` keeps that mode when it moves the directory to `_site`. `actions/upload-pages-artifact` packs the directory's own entry with that mode, and GitHub Pages refuses artifacts whose directories are not world-readable (`0755`) with `deployment_perms_error`, so the first deploy after the merge is expected to fail.","category":"Reliability","action_level":"action_required","attribution_status":"implemented","git_sha":"ebb67dd424ddef2c6959e947ee10a396a201b1e5","location":{"file_path":"scripts/build-site.ts","start_line":192,"end_line":194,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":"scripts/build-site.ts[190-202]"},{"source_type":"pr_branch_file","source":".github/workflows/pages.yml[48-59]"}]}}],"finding_state":{"complete":true,"introduced":[],"resolved":["723eb8cd-9e0d-4bf6-9370-0fe9ee6e14b8"],"still_open":[],"dismissed":[]},"review_agent_comment":"The workflow has not run yet, so please verify the first deployment end-to-end once Pages is enabled.","meta":{"analysis":{"attempted_mode":"incremental","baseline_checkpoint_id":"1350068b70e44964921e26e9779626b0","mode":"incremental","profile_changed":true,"reason":"changes_since_checkpoint"},"checkpoint":{"base_sha":"ebb67dd424ddef2c6959e947ee10a396a201b1e5","coverage_started_at":"2026-11-27T23:54:30.234814+00:00","created_at":"2026-11-28T00:05:41.454059+00:00","id":"3790b335bc4d44da8f8e8e82ad861348","sequence":42486,"tree_sha":"8a15f9b182b0ef7b11dc98a36d05475cce2136a4","version":1},"context":{"author_notes":{"input_chars":3951,"max_tokens":16000,"offloaded":false,"original_tokens":923,"outcome":"inline","rendered_chars":4121},"ticket_bodies":[{"index":1,"input_chars":8473,"max_tokens":5000,"offloaded":false,"original_tokens":2118,"out