{"findings":[{"id":"afdf2ca4-e08f-4767-88ba-bf2c64bb7b8c","title":"Nested builds leave parent folders after a failed write","description":"`main` creates `options.out` and any missing parents with recursive `mkdirSync`, but its write-failure cleanup removes only the leaf directory. When a write fails for a nested output path whose parents did not exist, those newly created parents remain; the write-failure test uses only a single new directory, so it does not catch this case.","category":"Reliability","action_level":"remediation_recommended","attribution_status":"pending","git_sha":"ebb67dd424ddef2c6959e947ee10a396a201b1e5","location":{"file_path":"scripts/build-site.ts","start_line":199,"end_line":201,"side":"right"},"evidence":{"citations":[{"source_type":"ticket","source":"https://github.com/UBayouski/tracenotes/issues/43"},{"source_type":"pr_branch_file","source":"scripts/build-site.ts[181-184]"},{"source_type":"pr_branch_file","source":"scripts/build-site.ts[196-201]"},{"source_type":"pr_branch_file","source":"tests/build-site.test.ts[147-161]"},{"source_type":"pr_branch_file","source":"scripts/build-site.ts[181-202]"},{"source_type":"pr_branch_file","source":"tests/build-site.test.ts[146-161]"},{"source_type":"pr_branch_file","source":"scripts/build-site.ts[193-201]"},{"source_type":"pr_branch_file","source":"tests/build-site.test.ts[146-159]"}]}},{"id":"51e2696c-6e32-4cdc-948f-c58609d06360","title":"Concurrent builds can delete each other's files","description":"`main` decides it owns the output directory with `existsSync` before `mkdirSync`, then unlinks predictable filenames on a write failure without checking who created them. If another process creates or writes to that directory between those steps, the failed build can remove that process's site files or empty directory.","category":"Reliability","action_level":"remediation_recommended","attribution_status":"pending","git_sha":"ebb67dd424ddef2c6959e947ee10a396a201b1e5","location":{"file_path":"scripts/build-site.ts","start_line":181,"end_line":182,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":"scripts/build-site.ts[181-191]"},{"source_type":"pr_branch_file","source":"scripts/build-site.ts[193-202]"}]}},{"id":"7cb90af9-b2d2-46a4-9866-f7bd7370a563","title":"Incomplete histories reach published notes","description":"`buildSite` treats `parseGitLog().malformed` as exhaustive validation, but the parser skips whitespace-only records and accepts a final record without its required terminator when its fields are otherwise valid. If either defect appears in the supplied stream, including a whitespace-only record before the requested commit, the build can succeed and write notes because its first-commit check examines the first parsed commit rather than the first record.","category":"Correctness","action_level":"remediation_recommended","attribution_status":"implemented","git_sha":"ebb67dd424ddef2c6959e947ee10a396a201b1e5","location":{"file_path":"scripts/build-site.ts","start_line":81,"end_line":82,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":"src/gitlog.ts[4-10]"},{"source_type":"pr_branch_file","source":"src/gitlog.ts[100-108]"},{"source_type":"pr_branch_file","source":"scripts/build-site.ts[81-96]"},{"source_type":"skill","source":"release-notes-audit"},{"source_type":"pr_branch_file","source":"scripts/build-site.ts[81-90]"},{"source_type":"pr_branch_file","source":"src/gitlog.ts[99-108]"}]}},{"id":"c03742ea-9d9c-426b-a89f-bf656739f3e0","title":"Failed builds leave incomplete site files","description":"`main` writes the four outputs directly to the destination in sequence, and its write-error handler does not remove files already created. If a later write fails, the command exits with an incomplete site that its non-empty-directory check rejects on retry.","category":"Reliability","action_level":"remediation_recommended","attribution_status":"implemented","git_sha":"ebb67dd424ddef2c6959e947ee10a396a201b1e5","location":{"file_path":"scripts/build-site.ts","start_line":164,"end_line":166,"side":"right"},"evidence":{"citations":[{"source_type":"pr_branch_file","source":"scripts/build-site.ts[159-167]"}]}}],"finding_state":{"complete":true,"introduced":["afdf2ca4-e08f-4767-88ba-bf2c64bb7b8c","51e2696c-6e32-4cdc-948f-c58609d06360"],"resolved":["7cb90af9-b2d2-46a4-9866-f7bd7370a563","c03742ea-9d9c-426b-a89f-bf656739f3e0"],"still_open":[],"dismissed":[]},"review_agent_comment":"Could you add a short comment if accepting BOM-prefixed streams is intentional? `buildSite` and `parseGitLog` handle the leading BOM differently, which may otherwise look like an inconsistency.","meta":{"analysis":{"attempted_mode":"incremental","baseline_checkpoint_id":"d53ace26db0340e5828ac749f0d439c5","mode":"incremental","profile_changed":true,"reason":"changes_since_checkpoint"},"checkpoint":{"base_sha":"ebb67dd424ddef2c6959e947ee10a396a201b1e5","coverage_started_at":"2026-11-27T23:54:30.234814+00:00","created_at":"2026-11-27T23:58:41.143357+00:00","id":"0499a2360c534adba579ff95d3cf1047","sequence":42481,"tree_sha":"8aed5d05f05b8699445e9c7f3c19d8d2c3492e66","version":1},"context":{"author_notes":{"input_chars":2873,"max_tokens":16000,"offloaded":false,"original_tokens":651,"outcome":"inline","rendered_chars":3043},"ticket_bodies":[{"index":1,"input_chars":8330,"max_tokens":5000,"offloaded":false,"original_tokens":2082,"outcome":"inline","rendered_chars":8330}]},"coverage":{"complete":true},"depth":"deep","org_config":"applied","reviewers":{"ran":["issue","compliance","skills"],"skipped":["spec","ui","persona","cross_repo"]},"run":{"effort":{"effective":"extended","requested":"deep"},"id":"fd25154fcd5a4978b825cd6a18ce3df7","passes":[{"agent_statuses_reported":true,"agents":[{"duration_ms":5645,"models":["multi-provider/claude-haiku-5-5"],"name":"compliance-agent-turbo","status":"completed"},{"duration_ms":8902,"models":["multi-provider/claude-haiku-5-5"],"name":"conversion_agent","status"